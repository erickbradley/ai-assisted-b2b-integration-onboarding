        <mxCell id="edge-15" value="Store permitted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#65758B;strokeWidth=1.5;fontColor=#34445C;fontSize=14;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="executor" target="artifacts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;Additional relationships are detailed on pages 2–3.&lt;/b&gt; Executor reads private input and records outcomes in DynamoDB; backend delivers retained files.&lt;br&gt;Artifacts are not public frontend origins. Bucket/table counts and backend operation grouping remain open.&lt;br&gt;&lt;b&gt;Legend:&lt;/b&gt; dashed = asynchronous handoff or configuration association; solid = task/data dependency. All relationships are conceptual." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#34445C;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="1160" width="1390" height="125" as="geometry" />
        </mxCell>
        <mxCell id="open" value="&lt;b&gt;Open before implementation:&lt;/b&gt; engine selection • compatibility method • model/prompt • managed-history privacy&lt;br&gt;Approval/callback and S3/DynamoDB consistency • timeout/cancellation • cost and request-size feasibility&lt;br&gt;Monitoring/cleanup/SNS and access/cost boundaries: page 3." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#34445C;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="1300" width="1390" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
