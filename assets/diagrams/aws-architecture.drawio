        <mxCell id="notes" value="&lt;b&gt;Failure boundaries:&lt;/b&gt; S3 publication and DynamoDB outcome recording are not one atomic transaction.&lt;br&gt;Confirmed results + final audit failure → true outcome with separate audit warning. Missing executor response is an uncertain outcome.&lt;br&gt;&lt;b&gt;User-initiated reprocessing:&lt;/b&gt; new linked run, fresh approval, original outcome preserved. Definition-sharing details deferred.&lt;br&gt;&lt;b&gt;Legend:&lt;/b&gt; dashed = asynchronous handoff; solid = task/data/decision dependency." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#34445C;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="1150" width="1390" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
