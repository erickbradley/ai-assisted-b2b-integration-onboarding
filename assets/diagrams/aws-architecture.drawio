        <mxCell id="budget" value="&lt;b&gt;Cost and workload proof&lt;/b&gt;&lt;br&gt;Provisional $20/month ceiling&lt;br&gt;Idle / active / per-run unvalidated" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3E4;strokeColor=#C88838;fontColor=#172B4D;fontFamily=Helvetica;fontSize=17;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1000" y="670" width="410" height="125" as="geometry" />
        </mxCell>
        <mxCell id="open" value="&lt;b&gt;Validate before implementation commitments&lt;/b&gt;&lt;br&gt;Engine/library vs Glue • model quality/latency • AI-independent compatibility • Standard history vs AI-context retention&lt;br&gt;Approval/callback and S3/DynamoDB consistency • worker timeout/cancellation • API/file limits&lt;br&gt;Active-work expiry coordination • durable-data backup/RPO • numeric quotas and retention windows" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3E4;strokeColor=#C88838;fontColor=#172B4D;fontFamily=Helvetica;fontSize=17;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="860" width="1340" height="155" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="No customer VPC/subnet requirement selected. Event buses/Pipes, Streams, SQS and S3-event starts are not selected intermediate hops.&lt;br&gt;CloudWatch/SNS are not a hard spend cap. Solid = data/task dependency; dashed = asynchronous trigger/delivery.&lt;br&gt;This is an architecture draft, not a compliance, implementation or cost guarantee." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#34445C;spacing=8;" vertex="1" parent="1">
